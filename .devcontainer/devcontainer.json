{
	"name": "voicebot",
	"build": {
		"dockerfile": "Containerfile",
		"context": ".",
		"args": {
			"FEDORA_COMPAT": "1", // enables fedora compatibility mode (extra dialout group with gid 18)
			"VARIANT": "25.04"
		}
	},
	"remoteUser": "ubuntu",
	"containerUser": "ubuntu",
	"customizations": {
		"vscode": {
			"settings": {
				"terminal.integrated.defaultProfile.linux": "zsh"
			},
			"extensions": [
				"ms-python.python",
				"skellock.just",
				"saoudrizwan.claude-dev"
			]
		}
	},
	"mounts": [
		"source=/dev/,target=/host/dev/,type=bind,consistency=consistent",
		"source=/run/user/1000,target=/run/user/1000,type=bind",

		// Host ALSA sound devices (mics + speakers), e.g. the reSpeaker XVF3800
		// USB 4-mic array. The container's *own* /dev is a snapshot taken when
		// the container was created, so a USB audio device plugged in after
		// launch never gets a node there (the same reason our USB code has to
		// look at /host/dev/bus/usb for touchpads). Binding the host's /dev/snd
		// *directory* is a live view, so cards added later show up immediately
		// as /dev/snd/controlCN + pcmCND0c/pcmCND0p.
		// Node permissions come from the host's seat ACL for uid 1000, which
		// still applies here because of --userns=keep-id in runArgs.
		// NOTE: /dev/snd must exist on the host; a missing bind source makes the
		// container refuse to start, so drop this line on a host with no sound.
		"source=/dev/snd,target=/dev/snd,type=bind,consistency=consistent",

		// VS Code's git-config export into the container is occasionally flaky.
		"source=${localEnv:HOME}${localEnv:USERPROFILE}/.gitconfig,target=/home/ubuntu/.gitconfig,type=bind,consistency=cached",

		// This is necessary to prevent newer vscode-created images from writing to /tmp.
		"type=tmpfs,destination=/tmp,tmpfs-mode=1777",

		// Atuin shell history: key + config (read-only) and a named volume for
		// the session db so it survives rebuilds.
		//"source=${localEnv:HOME}/.local/share/atuin/key,target=/home/ubuntu/.local/share/atuin/key,type=bind,consistency=cached,readonly",
		//"source=${localEnv:HOME}/.config/atuin/config.toml,target=/home/ubuntu/.config/atuin/config.toml,type=bind,consistency=cached,readonly",
		//"source=atuin-session-${localWorkspaceFolderBasename},target=/home/ubuntu/.local/share/atuin,type=volume"
	],
	"runArgs": [
		"--hostname=dc_${localWorkspaceFolderBasename}", // better than random digits
		"--privileged", // full hw access from the host (USB/audio devices, coredumps)
		"--network=host", // host network so mDNS/Tailscale reach the Ollama server
		"--user=1000:1000",
		"--security-opt=seccomp=unconfined",
		"--userns=keep-id:uid=1000,gid=1000",
		// Allow the container to reach host ports via host.docker.internal
		"--add-host=host.docker.internal:host-gateway"
	],
	"features": {
		// add git
		"ghcr.io/devcontainers/features/git:1": {},
		// https://just.systems/ — task runner used by ./justfile
		"ghcr.io/guiyomh/features/just:0": {}
	},
	"initializeCommand": "sudo chown -R 1000 /dev/bus/usb",
	// Runs once after the container is created (and after every rebuild).
	"postCreateCommand": "just install",
	"remoteEnv": {
		// Audio: the container runs no sound server of its own, so point
		// PulseAudio/PipeWire-pulse clients at the *host's* session server,
		// reachable through the /run/user/1000 bind mount above. This is what
		// makes the reSpeaker mic show up as a normal record source.
		// XDG_RUNTIME_DIR lets native PipeWire clients find pipewire-0.
		"PULSE_SERVER": "unix:/run/user/1000/pulse/native",
		"XDG_RUNTIME_DIR": "/run/user/1000"
	}
}
